# Required: paste an actually published reference from the Actions build output.
# Example format: ghcr.io/jstraw4663/chapterkeeparr@sha256:<manifest-digest>
# No release or preview image is guaranteed to exist until publishing succeeds.
CHAPTERKEEPARR_IMAGE=

CONTAINER_NAME=chapterkeeparr-test
CHAPTERKEEPER_PORT=8787
# Loopback by default. For LAN access, use the server's LAN IP and set a token.
CHAPTERKEEPER_BIND=127.0.0.1
CONFIG_HOST_PATH=/mnt/user/appdata/chapterkeeparr-test/config
LIBRARY_HOST_PATH=/mnt/user/media/chapterkeeparr-test
PUID=99
PGID=100
CHAPTERKEEPER_API_TOKEN=

# First inspect the UI and mappings with workers paused; then set to 1.
ENABLE_WORKERS=0
WORKERS=1
CPU_THREADS=4
CPU_LIMIT=4
MEM_LIMIT=4g
MEMSWAP_LIMIT=4g
# Disk cache budget, not RAM. Reports and active intermediates are separate.
CACHE_MAX_GB=10
